{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mocha core tool requests v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "read"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "max_lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "write"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "content": {
              "type": "string",
              "maxLength": 1048576
            },
            "observation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          },
          "required": [
            "path",
            "content",
            "observation_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "edit"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "old_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            },
            "new_text": {
              "type": "string",
              "maxLength": 1048576
            },
            "observation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "replace_all": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "old_text",
            "new_text",
            "observation_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "apply_patch"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "patch": {
              "type": "string",
              "maxLength": 1048576
            },
            "observations": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            }
          },
          "required": [
            "patch",
            "observations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "grep"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "maxLength": 4096
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "pattern"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "glob"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "maxLength": 4096
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "pattern"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "ls"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "bash"
        },
        "arguments": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "const": "run"
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1800000
                },
                "background": {
                  "type": "boolean"
                }
              },
              "required": [
                "operation",
                "command"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "enum": [
                    "status",
                    "output",
                    "kill"
                  ]
                },
                "job_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              },
              "required": [
                "operation",
                "job_id"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "todo"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "active",
                      "done"
                    ]
                  }
                },
                "required": [
                  "id",
                  "text",
                  "status"
                ],
                "additionalProperties": false
              },
              "maxItems": 200
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "ask_user"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "maxLength": 4096
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              },
              "maxItems": 20
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://mocha.invalid/contracts/tools.schema.json"
}
