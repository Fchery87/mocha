{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mocha trusted project config v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ui": {
      "type": "object",
      "properties": {
        "layout": {
          "enum": [
            "full",
            "inline"
          ]
        },
        "theme": {
          "enum": [
            "auto",
            "dark",
            "light"
          ]
        },
        "palette": {
          "const": "volt"
        },
        "motion": {
          "enum": [
            "full",
            "reduced"
          ]
        },
        "mouse": {
          "type": "boolean"
        },
        "ascii": {
          "type": "boolean"
        },
        "rail": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "selected_model": {
      "type": "object",
      "properties": {
        "connection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "connection_id",
        "model_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false,
  "$id": "https://mocha.invalid/contracts/project-config.schema.json"
}
